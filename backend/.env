# === Cosmix Backend — Environment Variables ===
# Copy this to .env and fill in your values

# App
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://cosmix_user:your_password@localhost:5432/cosmix_db

# Redis (for Celery job queue)
REDIS_URL=redis://localhost:6379/0

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-string

# OpenAI
ANTHROPIC_API_KEY=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
